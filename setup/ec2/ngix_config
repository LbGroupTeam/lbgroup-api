server {
    listen 80;
    server_name lbgroup.com.br www.lbgroup.com.br;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name lbgroup.com.br www.lbgroup.com.br;

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/lbgroup.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lbgroup.com.br/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Proxy requests from port 443 to frontend
    location / {
        proxy_pass http://localhost:3000; # Proxy to Next.js frontend
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 8080 ssl;
    server_name lbgroup.com.br www.lbgroup.com.br;

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/lbgroup.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lbgroup.com.br/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Proxy requests from port 8080 to the API
    location / {
        proxy_pass http://localhost:8081; # Proxy to backend API
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}